# Operator template. Copy to docker/.env and fill locally. Do not commit secrets.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_ADMIN_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_APP_PASSWORD
# Encode URL password characters; container hostnames are postgres and redis.
COMPOSE_DATABASE_URL=postgresql://commonroom:REPLACE_WITH_ENCODED_APP_PASSWORD@postgres:5432/commonroom
# Generate at least 64 hex characters: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
REDIS_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
COMPOSE_REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Run npm run admin:setup locally; copy only the hash/secret into this ignored file.
# Single-quote the scrypt hash to prevent Compose dollar-sign interpolation.
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# Configure only after a real verification gateway passes end-to-end checks.
AGE_MODE=provider
AGE_VERIFICATION_URL=https://YOUR_VERIFICATION_GATEWAY/start
AGE_WEBHOOK_SECRET=REPLACE_WITH_UNIQUE_RANDOM_GATEWAY_SECRET
AUDIT_RETENTION_DAYS=14
MAX_ACTIVE_SESSIONS=500
CLIENT_URL=https://YOUR_PUBLIC_HOST
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=turns:YOUR_TURN_HOST:5349
# Must match coturn's server-only use-auth-secret signing secret.
TURN_SHARED_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
TURN_CREDENTIAL_TTL_SECONDS=3600
ICE_TRANSPORT_POLICY=all
SESSION_TTL_SECONDS=7200
REPORT_RETENTION_DAYS=30
FACE_INTERVAL_MS=1500
FACE_WARNING_MS=10000
FACE_PAUSE_MS=30000
FACE_DISCONNECT_MS=60000
APP_HOST_PORT=3001
