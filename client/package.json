{
  "name": "@strangely/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "assets:face": "node ../scripts/prepare-face-assets.mjs",
    "build": "npm run assets:face && npm run typecheck && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1"
  },
  "dependencies": {
    "@strangely/shared": "*",
    "@mediapipe/tasks-vision": "1.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
