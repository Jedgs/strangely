NODE_ENV=development
PORT=3001
MAX_ACTIVE_SESSIONS=500
HOST=127.0.0.1
CLIENT_URL=http://127.0.0.1:5173
# For a frontend and API on different HTTPS origins, use:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
DATABASE_URL=postgresql://commonroom:CHANGE_ME@localhost:5432/commonroom
REDIS_URL=redis://localhost:6379
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
# Coturn use-auth-secret shared secret, SERVER ONLY. No static browser password.
TURN_SHARED_SECRET=
# Xirsys alternative: keep these server-only; do not use VITE_* names.
XIRSYS_IDENT=
XIRSYS_SECRET=
XIRSYS_CHANNEL=
TURN_CREDENTIAL_TTL_SECONDS=3600
ICE_TRANSPORT_POLICY=all
SESSION_TTL_SECONDS=7200
REPORT_RETENTION_DAYS=30
FACE_INTERVAL_MS=1500
FACE_WARNING_MS=10000
FACE_PAUSE_MS=30000
FACE_DISCONNECT_MS=60000
# Only enable when a trusted reverse proxy overwrites forwarded headers.
TRUST_PROXY=false
# Optional country display only behind an edge that strips spoofed headers and
# prevents direct origin access. Never used as proof of identity or for bans.
TRUST_EDGE_COUNTRY=false
EDGE_GEO_SECRET=
# Public startup requires provider mode and a real, tested verification gateway.
AGE_MODE=development
AGE_VERIFICATION_URL=
AGE_WEBHOOK_SECRET=
# Run npm run admin:setup locally. Never put any of these in VITE_* or GitHub.
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
AUDIT_RETENTION_DAYS=14
