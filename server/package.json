{
  "name": "@strangely/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && node ../scripts/copy-server-assets.mjs",
    "start": "node --env-file-if-exists=../.env dist/server/src/index.js",
    "db:migrate": "node --env-file-if-exists=../.env dist/server/src/database/migrate.js",
    "db:retention": "node --env-file-if-exists=../.env dist/server/src/database/retention.js",
    "db:migrate:dev": "node --env-file-if-exists=../.env --import tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@strangely/shared": "*",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "fastify": "5.12.5",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
